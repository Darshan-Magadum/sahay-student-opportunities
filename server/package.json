{
  "name": "sahay-server",
  "version": "1.0.0",
  "description": "Sahay Backend API",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node seed.js",
    "sync": "node -e \"import('./db.js').then(m=>m.connectDB()).then(()=>import('./services/ingestionService.js')).then(m=>m.ingestionService.syncAll({force:true})).then(()=>process.exit(0))\"",
    "test:ingestion": "node verify-integration.mjs"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "mongodb": "^7.7.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
